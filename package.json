{
  "name": "autotube-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"web,worker\" -c \"blue,green\" \"next dev\" \"tsx watch worker.ts\"",
    "dev:web": "next dev",
    "dev:worker": "tsx watch worker.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx worker.ts",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "tsx tests/encryption.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.453.0",
    "next": "^14.2.18",
    "next-auth": "^4.24.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.8",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
